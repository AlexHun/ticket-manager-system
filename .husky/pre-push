# Slow gate — the API suite, plus a typecheck the pre-commit hook may never
# have run (a `--no-verify` commit, a commit made by another tool, a rebase).
#
# The web suite is not here. It is jsdom-bound and took ~4m54s of every push
# on a Windows dev machine, and CI runs it on every PR anyway. CLAUDE.md makes
# a green PR the finish line, so CI owns it. The API suite stays: it is
# fast enough to pay per push, and it is the one that exercises the database.
#
# Measured 2026-09-24 on a Windows dev machine, warm: typecheck ~16s,
# `@ticket/api` ~33s — under a minute. A cold first run takes about twice that.
#
# E2E is not here either. It needs a Postgres, a migrated ticket_manager_test
# and two servers on alt ports (SCRIPTS.md); CI's `e2e` job owns it.
#
# A passing suite prints only its totals. Its full output ran to ~20.7k
# characters per push (132 `[ai]` usage lines, the job logs, four
# `prisma:error` blocks from tests that roll back on purpose), and every
# agent push carried it into the agent's context; a failure still prints all
# of it.
bun run typecheck
log=$(mktemp)
echo "API suite: running, full output only on failure"
if bun run --filter @ticket/api test >"$log" 2>&1; then
  grep -E ' [0-9]+ (pass|fail|skip)[[:space:]]*$|Ran [0-9]+ tests' "$log"
  rm -f "$log"
else
  cat "$log"
  rm -f "$log"
  exit 1
fi
