# Layered on top of .env.test with dotenv-cli's `-o`/`--override` flag (see
# playwright.config.ts) to boot a SECOND API instance, on its own port, with AI
# switched on and pointed at the E2E suite's fake-OpenAI stub instead of the
# real network. Everything not redefined here (DATABASE_URL,
# BETTER_AUTH_SECRET, TRUSTED_ORIGINS, SEED_ADMIN_*, webhook creds) is
# inherited from .env.test unchanged, including NODE_ENV=test — which is what
# keeps Better Auth's origin check disabled here too.
#
# This process talks to the SAME ticket_manager_test database as the ordinary
# :3002 server. That is only safe because playwright.config.ts runs with
# `fullyParallel: false, workers: 1` — nothing else is writing at the same time.
#
# `-o` is not optional: dotenv's default `override: false` means a key already
# set by the first `-e .env.test` load is left alone by the second file, which
# would silently keep AUTO_REPLY_ENABLED=false and the empty OPENAI_API_KEY
# from .env.test. Verified against node_modules/dotenv's `populate()` — override
# is the only thing that makes a later `-e` file win.

# A distinct port so this instance can run alongside the suite's ordinary
# :3002 API server rather than replacing it.
PORT=3003

# Any non-empty string satisfies `isAiConfigured()`. It is never sent anywhere
# real: `OPENAI_BASE_URL` below redirects every call to the local stub, which
# does not check it.
OPENAI_API_KEY=e2e-fake-key

# tests/e2e/fake-openai/constants.ts is the source of truth for this port
# (STUB_PORT) — keep the two in sync.
OPENAI_BASE_URL=http://localhost:3999

# The two switches this whole extra server exists to flip. Off in .env.test on
# purpose (see the comment there) so every other spec keeps testing an
# AI-disabled deployment; on here so this one process can drive the real
# classify -> gate -> auto-reply -> approval pipeline end to end.
AUTO_REPLY_ENABLED=true
PIPELINE_SIMULATOR_ENABLED=true
