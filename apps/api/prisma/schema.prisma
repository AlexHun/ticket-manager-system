generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                       @id
  name                 String
  email                String
  emailVerified        Boolean                      @default(false)
  image                String?
  role                 Role                         @default(agent)
  /// This row stands for the assistant rather than for a person.
  ///
  /// **Meant to be unique, and kept that way by having one writer.** Nothing in
  /// the API can set this column — not `POST /api/users`, not the Better Auth
  /// handler, not the admin update route — so the only thing that ever writes
  /// `true` is `prisma/seed.ts`, which looks for the row before creating one and
  /// is therefore safe to run repeatedly. A partial unique index (`WHERE
  /// "automated"`) would state the invariant in the database, and it was left
  /// out on purpose: Prisma cannot express one, so it would live only in the
  /// migration, read as drift on the next `migrate dev`, and be silently dropped
  /// by the migration that got generated to "fix" it. `assistantUser()` orders
  /// the lookup so that even a second row could not change which one is used.
  ///
  /// Not a third `Role`, and the distinction is the point: a role says what an
  /// account may do, and this account may do nothing. It has no `Account` row,
  /// so there is no password to check and nothing can sign in as it, and the
  /// mutating user routes refuse it outright. It exists to be the assignee on a
  /// ticket the machine finished, so the assignee column answers "who dealt with
  /// this" for every ticket instead of going blank on the automated ones.
  automated            Boolean                      @default(false)
  banned               Boolean?                     @default(false)
  banReason            String?
  banExpires           DateTime?
  deletedAt            DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  sessions             Session[]
  accounts             Account[]
  assignedTickets      Ticket[]                     @relation("TicketAssignee")
  authoredMessages     Message[]
  knowledgeEdits       KnowledgeArticleRevision[]
  knowledgeApprovals   KnowledgeArticleRevision[]   @relation("KnowledgeRevisionApprover")
  ticketActivity       TicketActivity[]
  handoffFor           AutomationSettings[]         @relation("HandoffAssignee")
  automationEdits      AutomationSettings[]         @relation("AutomationEditor")
  adminActivityActed   AdminActivity[]              @relation("AdminActivityActor")
  adminActivityOn      AdminActivity[]              @relation("AdminActivityTarget")
  handoffRevisionsFrom AutomationSettingsRevision[] @relation("AutomationRevisionFromUser")
  handoffRevisionsTo   AutomationSettingsRevision[] @relation("AutomationRevisionToUser")
  handoffRevisionsMade AutomationSettingsRevision[] @relation("AutomationRevisionChangedBy")
  tutorialEdits        TutorialContent[]            @relation("TutorialContentEditor")
  tutorialProgress     TutorialProgress[]

  @@unique([email])
  /// One row matches, and several things ask for it — every handed-back ticket,
  /// every reopen, and the `/pipeline` screen.
  @@index([automated])
  @@map("user")
}

/// Where a ticket goes when the assistant is finished with it. One row, id 1.
///
/// A singleton table rather than an env var, because this is the one thing about
/// the unattended pipeline that a support lead has an opinion about and no
/// deploy access to change. Everything else on `/pipeline` — the API key, the
/// kill switch, the simulator — is a deployment decision and stays one.
///
/// The row may not exist. A deployment that has never opened the screen has no
/// settings, and that reads as `admin` (the default) everywhere rather than as
/// an error: `resolveHandoff` treats a missing row and a default row as the same
/// thing, so nothing has to be seeded for the feature to work.
///
/// Success is deliberately **not** configurable. A ticket the machine resolved
/// goes to the assistant's own account, full stop — that assignment is a record
/// of what happened, not a routing choice, and an admin who could point it at a
/// person would be filing a machine's work under somebody's name.
model AutomationSettings {
  /// Always 1. The default is what makes the upsert in `routes/automation.ts` a
  /// single statement with no "have we got a row yet" branch above it.
  id Int @id @default(1)

  /// Which of the three answers the admin chose.
  target HandoffTarget @default(admin)

  /// The person, when `target` is `user`; null otherwise, and the API rejects
  /// any other combination.
  ///
  /// `SetNull` covers a hard delete, but users here are *soft*-deleted, so the
  /// FK never fires and this can go on naming somebody who has left. That is
  /// handled where it has to be — `resolveHandoff` checks `deletedAt` and falls
  /// back to an admin — because a handoff target nobody can see is a ticket
  /// nobody works.
  handoffUserId String?
  handoffUser   User?   @relation("HandoffAssignee", fields: [handoffUserId], references: [id], onDelete: SetNull)

  updatedAt     DateTime @updatedAt
  /// Who changed it last. Denormalised alongside the FK for the same reason the
  /// knowledge-base revisions are: the name has to outlive the account.
  updatedById   String?
  updatedBy     User?    @relation("AutomationEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedByName String?

  @@index([handoffUserId])
  @@index([updatedById])
  @@map("automation_settings")
}

/// The three answers to "who picks up a ticket the assistant handed back".
/// Mirrors `HANDOFF_TARGET` in `@ticket/shared`; the API validates against that.
enum HandoffTarget {
  admin
  user
  unassigned
}

/// One recorded change to `AutomationSettings` — the handoff-target history.
///
/// `AutomationSettings` is a singleton row: every write overwrites `target` and
/// `handoffUserId` in place, so only the *current* value and its last editor
/// were ever known. This is the account-management trail's shape (a
/// transition, not a snapshot — the `AdminActivity` model's comment explains
/// why that fits here and not `KnowledgeArticleRevision`'s full-snapshot
/// shape) applied to the one other admin action with nothing durable behind
/// it: `PATCH /api/automation/handoff` used to only `console.log` a change.
///
/// **One field pair, one row per change.** Unlike `AdminActivity`, which
/// covers several distinct actions and therefore needs an `action` column,
/// there is only one thing that can change here — the target, and the user it
/// names when that target is `user` — so a before/after on that pair is the
/// whole story and no action enum is needed.
model AutomationSettingsRevision {
  id            Int           @id @default(autoincrement())
  fromTarget    HandoffTarget
  toTarget      HandoffTarget
  /// The named person on either side, only when that side's target is `user`;
  /// null otherwise. `SetNull` plus a denormalised name, same reasoning as
  /// `AutomationSettings.handoffUser`: the row has to keep naming somebody
  /// after their account is gone.
  fromUserId    String?
  fromUser      User?         @relation("AutomationRevisionFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  fromUserName  String?
  toUserId      String?
  toUser        User?         @relation("AutomationRevisionToUser", fields: [toUserId], references: [id], onDelete: SetNull)
  toUserName    String?
  /// The admin who made the change. Always present at write time — the route
  /// sits behind `requireAdmin` — and loses only its id, via `SetNull`, if
  /// that admin's account is later deleted.
  changedById   String?
  changedBy     User?         @relation("AutomationRevisionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedByName String
  createdAt     DateTime      @default(now())

  /// The only way this table is read today: everything, newest first.
  @@index([createdAt])
  /// Postgres does not index a foreign key for you — same reasoning as
  /// `AdminActivity`'s FK indexes.
  @@index([fromUserId])
  @@index([toUserId])
  @@index([changedById])
  @@map("automation_settings_revision")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

enum Role {
  admin
  agent
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Ticket {
  id                  Int              @id @default(autoincrement())
  subject             String
  status              TicketStatus     @default(New)
  category            TicketCategory?
  // When the automatic classifier reached a *terminal* verdict on this ticket:
  // it filed a category, or it gave up. Not "when the category was last set" —
  // an agent choosing one by hand leaves this null, and that difference is the
  // whole reason the column exists.
  //
  // `category` alone cannot answer "does this still need classifying". A null
  // category means either "never attempted" or "attempted, and an agent then
  // deliberately cleared it", and the reconciliation sweep in
  // `jobs/classify-ticket.ts` must re-enqueue the first and leave the second
  // alone. Set on success, and set again when a job exhausts its retries and
  // lands in the dead-letter queue, which is what stops that sweep re-queueing
  // a ticket forever.
  classifiedAt        DateTime?
  // When the knowledge-base auto-reply answered this ticket and resolved it.
  //
  // The classifier's `classifiedAt` records a verdict either way; this one only
  // ever records success, because the failures already have somewhere to live:
  // a declined ticket is moved to `Open`, which is a state an agent can see and
  // act on, and there is nothing more to say about it.
  //
  // Two things read it. A customer replying to a ticket the machine resolved
  // reopens it — that check is this column, and narrowing it that way is what
  // keeps a human's own "Resolved" from being undone by a thank-you note. And it
  // is the only durable record of how much of the queue answered itself, since
  // the reply in the thread says who wrote it but not that the ticket closed
  // because of it.
  autoResolvedAt      DateTime?
  // Why the auto-reply handed this ticket back, and when — the other half of
  // `autoResolvedAt`, which only ever records success.
  //
  // Declining is the designed outcome, not an error path, and until these
  // columns existed it was invisible: the reason went to a log line and the
  // ticket became an ordinary `Open` row, indistinguishable from one the
  // machine never saw. That cost an agent the knowledge that it had already
  // been considered, and an admin any way to tell a knowledge base that is
  // working from one that is failing every check.
  //
  // A plain string rather than a Postgres enum, unlike `status` and `category`.
  // Those are queried and filtered on and have a fixed small set; this one is
  // display-only, is written by exactly one function, and grows a value every
  // time a safety check is added to `ai/auto-reply.ts` — an enum would put a
  // migration in front of each of those. `AUTO_REPLY_DECLINE` in
  // `@ticket/shared` is the authority, and the API validates against it.
  //
  // Cleared when a reply eventually succeeds, so a ticket never carries both.
  autoReplyDecline    String?
  autoReplyDeclinedAt DateTime?
  customerEmail       String
  customerName        String
  lastMessageAt       DateTime         @default(now())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  assignedToId        String?
  assignedTo          User?            @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages            Message[]
  activity            TicketActivity[]

  @@index([customerEmail])
  @@index([lastMessageAt])
  @@index([assignedToId])
  // Every dashboard aggregate scopes on `createdAt >= from AND < to`, and the
  // ticket list's default sort is the same column.
  @@index([createdAt])
  // The backlog-age panel filters `status = Open` before that range scan, and
  // the list filters status and sorts within it. Status first: it is the
  // equality, and a range in the leading column would stop the second term
  // being usable.
  @@index([status, createdAt])
  @@map("ticket")
}

model Message {
  id              Int              @id @default(autoincrement())
  ticketId        Int
  ticket          Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId       String           @unique
  inReplyTo       String?
  senderEmail     String
  senderName      String
  textBody        String?
  htmlBody        String?
  direction       MessageDirection @default(inbound)
  // The agent who wrote an outbound reply. Null on everything inbound — a
  // customer has no row in the user table — and null again once that agent is
  // deleted, which is why SetNull and not Cascade: removing a colleague must
  // not take their replies out of a customer's thread. `senderName` and
  // `senderEmail` are written alongside it and are what the thread renders, so
  // a reply stays attributed after the FK has been cleared.
  authorId        String?
  author          User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // Written by the knowledge-base auto-reply rather than by a person.
  //
  // Not derivable from `authorId`. That is null here, but it is also null on a
  // reply whose author was deleted afterwards — and "nobody wrote this" and "the
  // colleague who wrote this has left" are different facts an agent reading the
  // thread needs told apart. Inbound messages are never automated: the flag
  // describes who composed our side of the conversation.
  automated       Boolean          @default(false)
  // The knowledge-base articles this reply was built from — "KB-004", and so on.
  //
  // Empty on everything a person wrote and on everything inbound; only the
  // auto-reply fills it. It is the audit trail for the one feature here that
  // writes to a customer with nobody reading it first: the ids are already
  // resolved and validated against the corpus the model was actually given
  // (check 4 in `ai/auto-reply.ts`, which throws the reply away when none of
  // them resolve), so storing them costs a column and turns "a machine sent
  // this" into "a machine sent this, and here is what it read".
  //
  // Without it the only trace was a log line, which is the wrong place: the
  // question "why did we tell this customer that?" is asked at the ticket,
  // often weeks later, by someone who does not have the logs.
  citedArticleIds String[]
  // The AI-polished draft this reply was sent from — what `POST
  // /api/ai/polish-reply` handed the agent, whether they sent it unedited or
  // rewrote it further before pressing Send.
  //
  // Null on everything inbound, on an assistant reply (the auto-reply never
  // touches Polish), and on an agent reply that was typed by hand or that
  // undid its polish before sending. Non-null is what lets `textBody` above be
  // compared against the draft it started from — "average agent edit
  // distance" (part of #16) needs both halves of that pair, and this column is
  // what stops the second half being thrown away at send time. Nothing
  // computes the distance yet; this only stops the data being lost.
  polishedDraft   String?
  /// The outbox row that carries this message to the customer, once there is one.
  ///
  /// Null on every inbound message — nothing we received is anything we send —
  /// and null on an outbound one only in the window between the two writes,
  /// which is no window at all: they commit in the same transaction.
  outboundEmail   OutboundEmail?
  createdAt       DateTime         @default(now())

  @@index([ticketId, createdAt])
  // For the first-response LATERAL in `ticket-stats.ts`, which wants the
  // earliest *outbound* message per ticket. `(ticketId, createdAt)` above gets
  // it to the right ticket but not past the inbound messages, so it walks the
  // thread until an outbound one turns up — on a long thread answered late,
  // that is most of it. With `direction` in the middle the LIMIT 1 lands on the
  // first row read.
  @@index([ticketId, direction, createdAt])
  @@index([inReplyTo])
  // Postgres does not index a foreign key for you. Without this, clearing an
  // author on a user delete seq-scans `message`, and so would any later "what
  // has this agent answered" query. `ticket.assignedToId` is indexed for the
  // identical reason.
  @@index([authorId])
  // Same reasoning as `TicketActivity`'s own `@@index([createdAt])`: the
  // unified activity feed reads every outbound reply, newest first, across
  // every ticket, and the index above leads with `ticketId` — no help to a
  // query that doesn't have one. `direction` first, not `createdAt` first,
  // because the feed always filters to `outbound` and never wants inbound mail
  // in the same scan.
  @@index([direction, createdAt])
  @@map("message")
}

/// Declaration order is sort order: Postgres orders an enum by the position of
/// each label, and the tickets list sorts by this column. So these read as the
/// lifecycle — New, Processing, Open, Resolved, Closed — and mirror
/// `TICKET_STATUS` in `@ticket/shared` exactly.
///
/// Prisma appends a new label to the end of the type, so the two migrations that
/// introduced New and Processing were hand-edited to `ADD VALUE ... BEFORE` in
/// order to land them here. Adding another label means doing the same, or the
/// list will silently sort it last whatever this file says.
enum TicketStatus {
  New
  Processing
  Open
  Resolved
  Closed
}

enum TicketCategory {
  General
  Technical
  Refund
  Other
}

enum MessageDirection {
  inbound
  outbound
}

/// One recorded change to a ticket.
///
/// The knowledge base has had a trail since the day its corpus moved into the
/// database; tickets have not, and they need one more, because **three of the
/// writers are machines**. The classifier files a category with nobody watching,
/// and the auto-reply either resolves a ticket under the assistant's account or
/// hands it back `Open` for one of nine reasons. Until this table, the answer to
/// "why is this Resolved and filed under the assistant?" was a log line nobody
/// kept, read weeks later by someone who does not have the logs.
///
/// **A transition, not a snapshot** — the one place it departs from
/// `KnowledgeArticleRevision`. A revision copies the whole article because an
/// article is a document you may want to diff or restore. A ticket's history is
/// a sequence of single-field moves, and copying the subject and the customer
/// onto every row would buy nothing.
///
/// **`Cascade`, where the revision uses `Restrict`** — the other departure. A
/// revision is evidence for replies already sitting in customers' inboxes, so
/// what it describes must never be deletable. This is *about* its ticket and
/// means nothing without it; `Message` cascades for the same reason, and
/// `prisma/seed-tickets.ts --reset` depends on it.
model TicketActivity {
  id         Int                  @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  action     TicketActivityAction
  /// The move, as it will be read — `"Open"`, `"Technical"`, an assignee's
  /// *name*, or an `AutoReplyDecline` reason. Null on either side means there was
  /// nothing there: an unassigned ticket, a cleared category, a `created` entry.
  ///
  /// Text rather than three typed column pairs, and an assignee by name rather
  /// than by id, for the reason `autoReplyDecline` is text and `editorName` is
  /// denormalised: this column is display-only, is never filtered on, and has to
  /// stay readable on the day the account it names is deleted — which is exactly
  /// when a trail gets read. `ACTIVITY_PHRASING` in `@ticket/shared` is the one
  /// authority on how a row reads.
  fromValue  String?
  toValue    String?
  actorKind  TicketActorKind
  /// Null for a customer, who has no account, and null again once an agent's
  /// account is deleted — hence `SetNull`, and hence the two columns under it.
  actorId    String?
  actor      User?                @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String
  /// Null for a customer: the address is on the ticket and on every message they
  /// sent, and copying it here would put it in a third place to keep in step.
  actorEmail String?
  createdAt  DateTime             @default(now())

  /// The only way this table is read on its own: one ticket, oldest first.
  @@index([ticketId, createdAt])
  /// Postgres does not index a foreign key for you, and clearing `actorId` on a
  /// user delete would otherwise seq-scan the whole table. Same reason
  /// `message.authorId` is indexed.
  @@index([actorId])
  /// The unified activity feed (`GET /api/activity`, `routes/activity.ts`)
  /// reads this table with no `ticketId` in the predicate at all — newest
  /// first, across every ticket — which the index above cannot serve: `ticketId`
  /// leads it, so a global scan skips straight past it. Mirrors the plain
  /// `@@index([createdAt])` `AdminActivity`, `AutomationSettingsRevision` and
  /// `KnowledgeArticleRevision` already carry for the same reason — this table
  /// was the one still missing it, because until the feed existed nothing ever
  /// read it that way.
  @@index([createdAt])
  @@map("ticket_activity")
}

/// What happened. Mirrors `TICKET_ACTIVITY_ACTION` in `@ticket/shared`, where
/// `ACTIVITY_PHRASING` is a `Record` over this union — so a tenth action cannot
/// be added without someone saying how it reads on screen.
enum TicketActivityAction {
  created
  status_changed
  category_changed
  assignee_changed
  reopened
  auto_resolved
  auto_declined
}

/// Who acted. Not a `Role`: the question here is what kind of thing made the
/// change, and two of the three answers are not people.
enum TicketActorKind {
  /// A signed-in person, agent or admin.
  agent
  /// The automated `User` row — `actorId` points at it, so this table and the
  /// assignee column name the machine identically.
  assistant
  /// An inbound email did it. No account behind it, so no `actorId`.
  customer
}

/// One recorded admin action against a colleague's account.
///
/// The account-management analogue of `TicketActivity`, written for the same
/// reason: `routes/users.ts` performs create/invite/edit/delete with nothing
/// durable behind it today, unlike tickets and the knowledge base, which both
/// already have a trail. Same shape as `TicketActivity` — a transition, not a
/// snapshot, `fromValue`/`toValue` are display strings and never ids, both
/// account columns are denormalised and `SetNull` so the row outlives either
/// account it names — but there is no cascade parent here: an `AdminActivity`
/// row is not *about* a ticket, it stands on its own.
model AdminActivity {
  id             Int                 @id @default(autoincrement())
  action         AdminActivityAction
  /// The move, as it will be read — currently only meaningful for `user_edited`
  /// (`"Name: Old"` / `"Name: New"`, one row per changed field) and
  /// `user_invited` (`"initial"` / `"resend"`, `toValue` only). Null on both
  /// sides for `user_created` and `user_deleted`, where the action says
  /// everything there is to say. `role_changed` would use the two roles the
  /// same way once something writes it — see the enum note below.
  fromValue      String?
  toValue        String?
  /// The admin who acted. Always present at write time — every route here sits
  /// behind `requireAdmin` — so unlike `TicketActivity.actorEmail` this is
  /// never null going in; it only loses its id, via `SetNull`, if that admin's
  /// account is later hard-deleted.
  actorId        String?
  actor          User?               @relation("AdminActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName      String
  actorEmail     String
  /// The account acted on. Denormalised for the same reason as the actor: a
  /// `user_deleted` row's whole point is to outlive the row it describes.
  targetUserId   String?
  target         User?               @relation("AdminActivityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetUserName String
  createdAt      DateTime            @default(now())

  /// The only way this table is read today: everything, newest first.
  @@index([createdAt])
  /// Postgres does not index a foreign key for you — same reasoning as
  /// `TicketActivity`'s two FK indexes.
  @@index([actorId])
  @@index([targetUserId])
  @@map("admin_activity")
}

/// What happened. Mirrors `ADMIN_ACTIVITY_ACTION` in `@ticket/shared`.
enum AdminActivityAction {
  user_created
  /// Covers both the initial invite (`POST /`) and a resend
  /// (`POST /:id/invite`) — `toValue` says which.
  user_invited
  user_edited
  /// No route sets a colleague's role today — `role` is fixed at creation
  /// (`Role.agent` by default) and there is no admin-facing way to change it.
  /// Reserved so the enum does not need a migration the day one is added.
  role_changed
  user_deleted
}

/// A knowledge-base article: the grounding material the unattended auto-reply
/// answers from, and the single most privileged content in this database.
///
/// It used to be `apps/api/knowledge-base.md`, parsed at boot, and that file's
/// own header argued for keeping it a file — reviewable in a pull request, and
/// beyond the reach of anyone who talks their way into an admin session. It set
/// one condition for moving here, which this schema is the first half of: "a
/// table can come later; it should come with an audit log." Every write to this
/// model must therefore write a `KnowledgeArticleRevision` in the same
/// transaction. That is not a convention, it is the entire reason the trade was
/// acceptable. The markdown file survives as the seed corpus for a fresh
/// deployment; it is no longer read at runtime.
model KnowledgeArticle {
  /// `KB-001`, and the citation contract. `message.citedArticleIds` holds these
  /// strings on every reply the machine has ever written, so an id is stable
  /// and is **never reused** — `nextArticleId` counts from the highest that has
  /// ever existed, archived rows included, rather than from the row count.
  id           String                     @id
  /// The question, phrased the way a customer would ask it.
  title        String
  category     TicketCategory
  /// The answer, and the only column here that ever reaches a model.
  body         String
  /// What a person needs to know and a customer must never be told: what not to
  /// promise, when to escalate, which figure to check first.
  ///
  /// A column of its own rather than `> Internal:` lines inside the body, which
  /// is how the markdown file carried them. The parser stripped those with a
  /// regex before assembling the corpus; here the corpus query simply does not
  /// select this column, so the guarantee moved from "a regex removed it" to
  /// "the prompt was never given it". Keep it that way: no query that builds a
  /// prompt may name this field.
  internalNote String?
  /// Whether the unattended auto-reply may answer from this article at all.
  ///
  /// The **first** gate on the whole feature and the only one that lives in
  /// content rather than in code — everything downstream checks what a model
  /// produced, this decides what it was ever asked. Default false, deliberately:
  /// a new article is withheld until somebody says otherwise, so the failure
  /// mode of a half-finished edit is an article nobody answers from.
  autoReply    Boolean                    @default(false)
  /// Retired, but still resolvable.
  ///
  /// Archived rather than deleted because `message.citedArticleIds` points here
  /// from replies already sitting in customers' threads, and "why did we tell
  /// them that?" is asked weeks later. An archived article is out of every
  /// prompt and out of the corpus, and still readable at the id that cited it.
  archived     Boolean                    @default(false)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  revisions    KnowledgeArticleRevision[]

  /// The corpus query: live, auto-replyable, ordered by id.
  @@index([archived, autoReply])
  @@map("knowledge_article")
}

/// One recorded change to one article: what it became, who made it, when.
///
/// A full snapshot per revision rather than a diff. A diff chain is only as good
/// as every link in it, and the question this exists to answer — "what did the
/// prompt say on the day we sent that reply?" — is asked about one moment, not
/// about a sequence.
model KnowledgeArticleRevision {
  id             Int                     @id @default(autoincrement())
  articleId      String
  /// `Restrict`, not `Cascade`: an article with revisions cannot be deleted, so
  /// the audit trail cannot be erased by removing what it describes. Since every
  /// article gets a `created` revision in the same transaction that inserts it,
  /// this makes articles undeletable through the ORM by construction. Archive
  /// instead — that is what `archived` is for.
  article        KnowledgeArticle        @relation(fields: [articleId], references: [id], onDelete: Restrict)
  action         KnowledgeRevisionAction
  /// The article as it stood *after* this change.
  title          String
  category       TicketCategory
  body           String
  internalNote   String?
  autoReply      Boolean
  archived       Boolean
  /// Who did it. Null for the one-time import from `knowledge-base.md`, and null
  /// again once that admin's account is deleted — hence `SetNull` and hence the
  /// two denormalised columns below, which are what keep the trail readable
  /// after the account is gone. An audit log that forgets who acted the moment
  /// they leave is not an audit log.
  editorId       String?
  editor         User?                   @relation(fields: [editorId], references: [id], onDelete: SetNull)
  editorName     String
  /// Null for the import, which had no account behind it.
  editorEmail    String?
  /// Pending, approved, or turned down — see the enum's own comment.
  ///
  /// Default `approved`. Every write this codebase makes today
  /// (`routes/knowledge.ts`) still applies the change to the live article and
  /// logs it in the same transaction — there is no second admin yet, so the one
  /// who wrote it is the only approval that has ever existed, and this default
  /// says that truthfully rather than backdating a workflow that does not exist
  /// yet. The approval flow this unlocks — submit a `pending` revision, copy it
  /// onto the live article only once a second admin approves it — is the next
  /// ticket in this chain.
  status         KnowledgeRevisionStatus @default(approved)
  /// Who approved this revision, and when. Both stay null for a revision that
  /// is `approved` only by the default above, or still `pending` — set only by
  /// an actual second-admin approval, never backfilled to match a status.
  approvedById   String?
  approvedBy     User?                   @relation("KnowledgeRevisionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedByName String?
  approvedAt     DateTime?
  createdAt      DateTime                @default(now())

  @@index([articleId, createdAt])
  @@index([editorId])
  @@index([createdAt])
  /// The pending-revision review queue this status column exists for: every
  /// article with something awaiting a second admin, across the whole corpus.
  @@index([status])
  @@map("knowledge_article_revision")
}

enum KnowledgeRevisionAction {
  created
  updated
  archived
  restored
}

/// Where a revision sits in the approval workflow the next ticket in this
/// chain builds on this column. `approved` is also the default for every
/// revision written before that workflow exists — see the field's own comment
/// for why that is honest rather than a placeholder.
enum KnowledgeRevisionStatus {
  pending
  approved
  rejected
}

/// One email this system intends to hand to a mail provider.
///
/// **The outbox.** Until this table existed, "we wrote a row" and "the customer
/// got an email" were the same event, because writing was all that happened.
/// The moment a provider is wired in they are two events that can disagree: the
/// row commits, the HTTP call fails, and nothing anywhere records the
/// difference. This table is where that difference lives.
///
/// It also settles a problem that has no other answer. `sendReply` is called
/// *inside* `prisma.$transaction` by `jobs/auto-reply-ticket.ts`, deliberately,
/// so the reply and the status transition that proves the worker still held its
/// claim commit together. An HTTP call cannot go there — it would hold a
/// Postgres transaction open across a round trip to a third party, and a
/// rollback cannot un-send an email. So the transaction writes *this row*
/// instead, and a `pg-boss` worker does the network call afterwards, outside any
/// transaction. That is the same shape `ingest.ts` already uses when it enqueues
/// classification inside the transaction that creates the ticket.
///
/// **Self-contained on purpose.** Everything the provider needs is a column
/// here, including the threading headers that also live on `Message`. The
/// duplication is the point: the worker takes a row and sends it, knowing
/// nothing about tickets, agents, articles or auth. A worker that had to reach
/// back through a relation for a reply and take a different path for a password
/// reset would be two workers wearing one name.
model OutboundEmail {
  id                Int                 @id @default(autoincrement())
  kind              OutboundEmailKind
  /// The thread message this email carries, when it carries one.
  ///
  /// Null on everything from the auth side — a password reset belongs to no
  /// ticket and must never appear in a customer's thread. Unique because a
  /// message is sent once; a second row for the same message would be a
  /// duplicate email, and the database says so rather than the code remembering
  /// to.
  messageId         Int?                @unique
  message           Message?            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  toEmail           String
  toName            String?
  subject           String
  textBody          String
  /// The RFC 5322 `Message-ID`, `In-Reply-To` and `References` this email is to
  /// be sent with — stored without angle brackets, exactly as `Message` and
  /// `ingest.ts` store them, so a customer's reply threads back onto the same
  /// ticket. Null/empty on auth mail, which is not part of any conversation.
  emailMessageId    String?
  inReplyTo         String?
  references        String[]
  status            OutboundEmailStatus @default(queued)
  /// How many times the worker has handed this to a provider and been refused.
  /// Distinct from pg-boss's own retry count, which is lost once a job leaves
  /// the queue — this survives on the row an admin is looking at.
  attempts          Int                 @default(0)
  /// The provider's own id for the accepted message, for the day somebody has to
  /// ask Postmark what happened to it.
  providerMessageId String?
  /// Why the last attempt failed. Prose from the provider, shown to an admin and
  /// read by nothing.
  lastError         String?
  createdAt         DateTime            @default(now())
  /// When a provider accepted it. Null until then, and null forever on anything
  /// that never left.
  sentAt            DateTime?

  /// The viewer lists newest-first within a status, and the send worker's
  /// recovery sweep asks for `queued` by age.
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("outbound_email")
}

/// What an outbound email is for.
///
/// Not cosmetic, and not derivable from `messageId` being null. The two auth
/// kinds carry a **live single-use credential in `textBody`** — a reset link is
/// a working way into somebody's account until it expires — and `reply` never
/// does. Anything that decides how long a row is kept, or who may read one, has
/// to be able to tell them apart.
enum OutboundEmailKind {
  reply
  passwordReset
  invitation
}

/// How far an email got.
///
/// `undeliverable` is the one worth explaining: it means there was no provider
/// configured, so nothing was attempted. Deliberately not `failed` — nothing is
/// wrong with the email and nothing is wrong with the system; this deployment
/// simply has nowhere to send mail, which is a supported state and the one the
/// app runs in today. Collapsing the two would make a working deployment with no
/// Postmark key look like a broken one, and would hide real failures among
/// hundreds of rows that were never tried.
enum OutboundEmailStatus {
  queued
  sent
  failed
  undeliverable
}

/// The per-page walkthrough shown the first time (and again after a material
/// change) a user opens each of the eight main pages. Mirrors `TutorialPageKey`
/// in `@ticket/shared`.
///
/// A fixed enum, not a free-form string: nothing in the API can create a page
/// that isn't one of these eight, so `TutorialContent` can only ever hold
/// exactly the rows the frontend knows what to do with.
enum TutorialPageKey {
  dashboard
  tickets
  ticketDetail
  pipeline
  knowledge
  users
  activity
  outbox
}

/// One page's tutorial copy, admin-editable. One row per `TutorialPageKey` —
/// never created or removed through the API, only ever written to.
///
/// **The version that decides whether to re-show a tutorial lives in code, not
/// here.** `TUTORIAL_PAGE_VERSIONS` in `@ticket/shared` is a constant a
/// developer bumps by hand when a page's UI or business logic changes
/// materially — editing the title or steps below does not bump it and does not
/// re-trigger the tutorial for anyone who has already seen it. That is
/// deliberate: content edits (typo fixes, clearer wording) and "this page now
/// works differently" are different events, and only the second one should
/// interrupt someone who already knows the page.
///
/// A row may not exist — a page nobody has authored a tutorial for yet — and
/// that reads as "no content" rather than an error, the same way a missing
/// `AutomationSettings` row reads as its default: `GET /api/tutorials/:pageKey`
/// answers with empty steps, and empty steps is exactly what keeps the
/// tutorial from ever showing (see the route). Nothing needs seeding for the
/// feature to work.
model TutorialContent {
  pageKey       TutorialPageKey @id
  title         String
  /// `TutorialStep[]` (`{ title, body }`), in display order. Free-form Json
  /// rather than a child table: nothing here is ever queried by field, and
  /// order is exactly array order.
  steps         Json
  updatedAt     DateTime        @updatedAt
  /// Who edited it last. `SetNull` plus a denormalised name, same reasoning as
  /// `AutomationSettings.updatedBy`: the byline has to survive the editor's
  /// account being deleted.
  updatedById   String?
  updatedBy     User?           @relation("TutorialContentEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedByName String?

  @@index([updatedById])
  @@map("tutorial_content")
}

/// One user's "seen" mark for one page's tutorial: the highest version of that
/// page they have dismissed. Compared against `TUTORIAL_PAGE_VERSIONS[pageKey]`
/// at read time — there is no history here, only the latest mark, because
/// nothing ever needs to ask what version someone saw two changes ago.
///
/// `onDelete: Cascade`, unlike the audit-style relations elsewhere in this
/// schema: this row is not a record of an event, it is per-user UI state that
/// means nothing once the account it belongs to is gone — the same reasoning
/// Better Auth's own `Session`/`Account` models use, not the "outlive the
/// account" reasoning `TutorialContent.updatedBy` uses.
model TutorialProgress {
  id          Int             @id @default(autoincrement())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageKey     TutorialPageKey
  seenVersion Int
  seenAt      DateTime        @default(now())

  @@unique([userId, pageKey])
  @@map("tutorial_progress")
}
