PORT=3002
NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticket_manager_test?schema=public"

# Generate with: openssl rand -base64 32  (must be at least 32 characters)
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
BETTER_AUTH_URL=http://localhost:3002
TRUSTED_ORIGINS=http://localhost:4001

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123

INBOUND_EMAIL_WEBHOOK_USERNAME=test-webhook-user
INBOUND_EMAIL_WEBHOOK_PASSWORD=test-webhook-pass

# Empty on purpose, and declared rather than omitted. A test run must not spend
# money or depend on the network, so polishing stays off; declaring the key is
# what makes that stick, because `configuredKeys` in apps/web/dev/suites.ts
# strips every key any .env* file names from a spawned child's environment.
OPENAI_API_KEY=

# Consumed by the Playwright suite (tests/e2e/helpers/env.ts), not the API server.
# API_URL must match PORT above.
API_URL=http://localhost:3002
INBOUND_EMAIL_WEBHOOK_URL=http://localhost:3002/api/webhooks/inbound-email

AUTO_REPLY_ENABLED=false
