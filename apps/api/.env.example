PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticket_manager?schema=public"

# Generate with: openssl rand -base64 32  (must be at least 32 characters)
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
BETTER_AUTH_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:4000

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123

# Basic Auth credentials for the inbound-email webhook. Empty values reject all requests.
INBOUND_EMAIL_WEBHOOK_USERNAME=
INBOUND_EMAIL_WEBHOOK_PASSWORD=

# The AI features: reply polishing, ticket summaries, automatic ticket
# classification and knowledge-base auto-reply (OpenAI gpt-5-nano via the Vercel
# AI SDK). One key gates all four, because there is one account behind them.
# Optional: empty disables them — POST /api/ai/polish-reply and
# POST /api/ai/summarize-ticket answer 503 and say so, newly ingested tickets stay
# uncategorised and sit in New for an agent to pick up, and nothing else changes.
OPENAI_API_KEY=

# The kill switch for knowledge-base auto-reply, and the only one that stops it
# without also stopping classification. Set to "false" to turn it off; anything
# else (including absent) leaves it on.
#
# It exists because this is the one feature that writes to customers with nobody
# reading first: articles marked "Auto-reply: yes" in knowledge-base.md are put
# in front of newly classified tickets, and a ticket the model can answer gets
# that answer appended to its thread and is marked Resolved. Refund tickets are
# never answered this way. Deleting or emptying knowledge-base.md also disables
# it, but that is a change to a reviewed file, not a lever.
AUTO_REPLY_ENABLED=true
