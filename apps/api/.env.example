PORT=3001

# On Railway this comes from the Postgres service as a reference variable
# (${{Postgres.DATABASE_URL}}) — pg-boss opens its own small pool against the
# same string, in its own `pgboss` schema. See DEPLOYMENT.md.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticket_manager?schema=public"

# Generate with: openssl rand -base64 32  (must be at least 32 characters)
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET

# This API's own public origin. In production it is the API service's URL, not
# the web app's — Better Auth builds callback and cookie URLs from it.
BETTER_AUTH_URL=http://localhost:3001

# Comma-separated. Every origin allowed to call this API with credentials, which
# in production means the web service's public URL. Both CORS and Better Auth's
# origin check read this list, and an origin missing from it cannot sign in.
TRUSTED_ORIGINS=http://localhost:4000

# Optional, production only. The parent domain the session cookie is scoped to,
# e.g. ".example.com" for app.example.com + api.example.com.
#
# Leave it EMPTY on Railway's generated *.up.railway.app domains: that suffix is
# on the Public Suffix List, so the web and API services are different *sites*
# and no cookie may span them. Empty makes the cookie `SameSite=None; Secure`,
# which is the only thing that works there; TRUSTED_ORIGINS is what still limits
# who may use it.
#
# Set it once both services sit under a domain you own — the cookie goes back to
# `SameSite=Lax`, which is strictly stronger. It is validated at boot against
# TRUSTED_ORIGINS, so a value that could never be stored fails fast rather than
# presenting as "login succeeds, user still signed out". See apps/api/src/auth.ts.
COOKIE_DOMAIN=

# Set to "production" on a deployment. It is what makes Better Auth mark the
# session cookie Secure and turns the rate limiter on, and what stops
# `prisma/seed.ts` creating the demo agent account. The Dockerfile sets it, so
# this is only needed if you run the API some other way.
NODE_ENV=

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123

# Basic Auth credentials for the inbound-email webhook. Empty values reject all requests.
INBOUND_EMAIL_WEBHOOK_USERNAME=
INBOUND_EMAIL_WEBHOOK_PASSWORD=

# The AI features: reply polishing, ticket summaries, automatic ticket
# classification and knowledge-base auto-reply (OpenAI gpt-5-nano via the Vercel
# AI SDK). One key gates all four, because there is one account behind them.
# Optional: empty disables them — POST /api/ai/polish-reply and
# POST /api/ai/summarize-ticket answer 503 and say so, newly ingested tickets stay
# uncategorised and sit in New for an agent to pick up, and nothing else changes.
OPENAI_API_KEY=

# The kill switch for knowledge-base auto-reply, and the only one that stops it
# without also stopping classification. Set to "false" to turn it off; anything
# else (including absent) leaves it on.
#
# It exists because this is the one feature that writes to customers with nobody
# reading first: knowledge-base articles with auto-reply switched on (edited at
# /knowledge, admin-only) are put in front of newly classified tickets, and a
# ticket the model can answer gets that answer appended to its thread and is
# marked Resolved. Refund tickets are never answered this way. Archiving every
# auto-replyable article disables it too, but that is a dozen edits with an audit
# trail behind them, not a lever.
AUTO_REPLY_ENABLED=true

# The pipeline simulator at /pipeline (admin-only): POST /api/pipeline/simulate
# posts an email through the real ingestion path so you can watch a ticket be
# classified and answered or handed back.
#
# Default OFF — only "true" turns it on, and that asymmetry is the point. It
# creates real tickets and spends real model calls, so a deployment that never
# thought about it should be one that cannot. The sender's address is always
# forced onto sim.example.com (reserved by RFC 2606) whatever this is set to, so
# a simulated ticket can never cause mail to reach a real person.
PIPELINE_SIMULATOR_ENABLED=true

# Optional. Error reporting. Unset means the Sentry SDK never initialises and
# nothing is sent anywhere — the app behaves identically, so a fresh clone needs
# no Sentry account. Find it in Sentry under Project Settings → Client Keys (DSN).
SENTRY_DSN=

# Fraction of transactions sampled for performance tracing, 0 to 1. Left at 0
# deliberately: tracing this process would sample the AI calls and the queue,
# where the interesting spans are the ones carrying customer text and prompts.
SENTRY_TRACES_SAMPLE_RATE=0
