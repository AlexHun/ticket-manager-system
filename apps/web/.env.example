# Optional. Leave unset in dev — Vite proxies /api to the backend.
# In production, set to the API origin (e.g. https://api.example.com).
VITE_API_URL=

# Optional. Error reporting for the browser half. Unset means no Sentry.
# Baked into the bundle at build time, so changing it needs a rebuild, not just a
# redeploy — and so does the CSP entry derived from it in vite.config.ts.
VITE_SENTRY_DSN=

# Fraction of transactions sampled for performance tracing, 0 to 1.
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Optional. The environment errors are filed under in Sentry. Defaults to Vite's
# mode, which is already correct for the usual two: `development` under
# `vite dev`, `production` from `vite build`.
#
# Set it only for a build that is production-mode but not production — a staging
# deploy, or `vite preview` on your own machine — otherwise those errors land in
# the production list next to the real ones. Pass it to the build rather than
# putting it here (`VITE_SENTRY_ENVIRONMENT=staging bun run build`), because
# Vite loads .env in every mode and a value here would relabel production too.
VITE_SENTRY_ENVIRONMENT=

# Optional. Overrides the release name, which otherwise comes from git as
# web@<version>+<commit> (see releaseName() in vite.config.ts). For CI that would
# rather name releases after a tag or a build number.
VITE_SENTRY_RELEASE=
