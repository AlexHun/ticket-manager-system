# Production web server for the SPA, and the front door for the API.
#
# The API is still a separate Railway service, but the browser never talks to it
# directly: `/api/*` is proxied from here, so the app and its API share one
# origin. That is a **cookie** decision, not a routing preference. Sessions are
# cookies, and `up.railway.app` is on the Public Suffix List — so while the app
# called `api-x.up.railway.app` from `web-x.up.railway.app`, the two were
# different *sites*, the session cookie had to be `SameSite=None; Secure`, and
# every browser that blocks third-party cookies by default (Chrome incognito,
# Safari) presented sign-in as a 200 followed by a user who was still signed
# out. Measured: allowing third-party cookies for the site fixed it, which is
# not a thing anyone should have to ask a support agent to do.
#
# Same-origin removes the question rather than answering it. See `API_UPSTREAM`
# on the `handle /api/*` block below, and the `COOKIE_DOMAIN` note in
# `apps/api/src/auth.ts`.
{
	# No admin API is needed in Railway's environment, and config storage there
	# is not persistent anyway.
	admin off
	persist_config off
	# Railway terminates TLS at its edge. Leaving this on would make Caddy try to
	# provision its own certificate for a hostname it does not control.
	auto_https off

	log {
		format json
	}

	servers {
		# Trust Railway's proxy so client IPs and `X-Forwarded-*` are read from
		# the edge rather than from whatever a caller sends.
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

# Railway injects PORT and health-checks the same port.
:{$PORT:3000} {
	log {
		format json
	}

	# Security headers on every response this service writes.
	header {
		# The Content-Security-Policy line is generated at build time by
		# `cspCaddyPlugin` in vite.config.ts, from `csp.ts` — the same function
		# that produces the page's <meta> tag and the `vite preview` header.
		# It is a build output because the policy's `connect-src` is derived
		# from VITE_API_URL, so a hand-written copy here could only ever be a
		# stale guess at which API origin the bundle actually calls.
		#
		# This is the delivery `frame-ancestors` requires: browsers ignore that
		# directive in a meta tag. See the note in `csp.ts`.
		import csp.caddy

		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# Redundant beside `frame-ancestors 'none'` in the CSP, and kept for the
		# same reason `apps/api/src/index.ts` keeps it: a browser old enough to
		# support neither directive is the one case where the weaker rule wins.
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Vite emits content-hashed filenames under /assets, so those are safe to
	# cache forever. The SPA document must not be, or a deploy leaves browsers
	# running the previous bundle against the new API.
	#
	# The negated matcher is load-bearing and was written the obvious way first:
	# `header /index.html ...` matched almost nothing, because `try_files` serves
	# that file for `/` and for every client-side route while the matcher still
	# sees the *request* path. Measured — `/`, `/tickets` and `/pipeline` all came
	# back with no Cache-Control at all, which is the one case browsers are free
	# to invent their own.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	@document not path /assets/*
	header @document Cache-Control "no-cache"

	# Railway's healthcheck target. Cheaper and less ambiguous than serving the
	# SPA shell for it — a 200 here means Caddy is up, not that a rewrite chain
	# happened to end somewhere.
	handle /health {
		respond "OK" 200
	}

	# The API, on this origin. Everything the browser calls lives under /api —
	# Better Auth included (`app.all("/api/auth/{*any}")` in
	# apps/api/src/index.ts) — so one block covers the session cookie too, which
	# is the whole point.
	#
	# API_UPSTREAM is host:port, no scheme: on Railway it is the API service's
	# private address, set as a reference variable on *this* service so it
	# cannot go stale —
	#
	#   API_UPSTREAM = ${{<api-service>.RAILWAY_PRIVATE_DOMAIN}}:3001
	#
	# Private networking is IPv6-only and the API binds `::` (Bun's node:http
	# default — verified, not assumed), so this reaches it without leaving
	# Railway's network. The default below is for running this image beside a
	# local API; in a container that cannot reach one it fails as a 502 with the
	# refused dial in Caddy's log, which is a legible way to be wrong.
	#
	# `VITE_API_URL` must be **empty** for the build that runs behind this, so
	# axios uses relative URLs and the CSP's connect-src collapses to 'self'.
	# Both are baked in at build time — this is a rebuild, not a redeploy.
	#
	# The API keeps its own public domain, so Postmark's webhook still reaches it
	# directly and does not come through here.
	# X-Forwarded-For is deliberately left alone here, and that took a
	# measurement against the real deployment to get right. Recorded because the
	# obvious-looking change is the wrong one:
	#
	#   - Railway's edge **overwrites** the header. Sending
	#     `X-Forwarded-For: 9.9.9.9` arrived as `82.135.202.248, 152.233.43.33`
	#     — the real client and a Railway hop, with the forged value gone. So
	#     the leftmost entry is not attacker-controlled and needs no defending.
	#   - **Better Auth reads the leftmost entry** (`value.split(",")[0]` in
	#     `utils/get-request-ip.mjs`), and that is what the 5-per-minute rule on
	#     /sign-in/email is keyed on. Caddy appending its own peer on the right
	#     does not disturb it.
	#   - Rewriting the header to `{client_ip}` looked like the careful thing to
	#     do and was the opposite: Railway's inner hop (`152.233.43.33`) is a
	#     *public* address, so it is not in `trusted_proxies` and `{client_ip}`
	#     resolves to it rather than to the visitor. That would have given every
	#     visitor one shared sign-in budget — an outage anyone could cause with
	#     five bad passwords.
	#
	# Leave it unset unless you have re-measured on the platform you are on.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:localhost:3001}
	}

	handle {
		root * dist

		encode zstd gzip

		# Client-side routing: unknown paths are React Router's, not 404s.
		try_files {path} /index.html
		file_server
	}
}
