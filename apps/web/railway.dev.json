{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/web/Dockerfile.dev",
    "watchPatterns": [
      "apps/web/**",
      "apps/api/**",
      "packages/**",
      "package.json",
      "bun.lock",
      "tsconfig.base.json",
      ".dockerignore"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
