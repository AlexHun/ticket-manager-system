{
  "name": "claude-code-course-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:api": "bun --filter '@ticket/api' dev",
    "dev:web": "bun --filter '@ticket/web' dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "db:test:migrate": "cd apps/api && bun run db:test:migrate",
    "db:test:seed": "cd apps/api && bun run db:test:seed",
    "db:test:reset": "cd apps/api && bun run db:test:reset"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
