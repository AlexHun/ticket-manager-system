{
  "name": "claude-code-course-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:api": "bun --filter '@ticket/api' dev",
    "dev:web": "bun --filter '@ticket/web' dev",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-stop.ps1",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "db:test:migrate": "cd apps/api && bun run db:test:migrate",
    "db:test:seed": "cd apps/api && bun run db:test:seed",
    "db:test:reset": "cd apps/api && bun run db:test:reset"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@ticket/shared": "workspace:*",
    "@types/node": "^26.2.0",
    "chrome-devtools-mcp": "^1.7.0",
    "typescript": "^7.0.2"
  }
}
