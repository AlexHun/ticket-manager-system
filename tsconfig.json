{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // page.evaluate() callbacks are serialised and run in the browser, so specs
    // legitimately reference DOM globals. Scoped to the E2E project only.
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    // Specs reach apps/web/src/dev, whose modules import each other with a
    // `.ts` extension because Vite's config loader resolves nothing
    // extensionless (docs/standards/frontend.md). Both web configs allow it;
    // without it here, root tsc fails TS5097 on those imports (#553).
    "allowImportingTsExtensions": true
  },
  "include": ["playwright.config.ts", "tests/**/*.ts"]
}
